# Database
DATABASE_URL="postgresql://user:password@localhost:5432/modelarena"

# Redis
REDIS_URL="redis://localhost:6379"

# Cloudflare R2
# Manual uploads PUT straight to the bucket. Add a CORS rule on it allowing
# PUT with header Content-Type from your site's origin; without it uploads
# fall back to going through the app (subject to proxy body limits).
# Optional: a lifecycle rule deleting uploads/ objects after 1 day clears
# abandoned uploads.
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="modelarena"
R2_PUBLIC_URL="https://your-custom-domain.com"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# OAuth Provider
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# AI Providers
FAL_KEY="your-fal-api-key"
RUNWAY_API_KEY="your-runway-api-key"

# Admin whitelist (comma-separated emails)
ADMIN_EMAILS="your-email@example.com"

# Optional: header holding the real client IP when a CDN sits in front of the
# proxy (e.g. "cf-connecting-ip" behind Cloudflare). Default: rightmost X-Forwarded-For.
# CLIENT_IP_HEADER="cf-connecting-ip"
